# ROVANTA configuration reference.
#
# The CLI does NOT load .env files automatically. Either export these
# variables in your shell, or store them in the ROVANTA config file:
#
#   rovanta config set COINGECKO_API_KEY <value>
#
# Environment variables take precedence over the config file. Never commit
# files containing real values.

# --- LLM (bring your own model) ---------------------------------------------
# ROVANTA does not provide or proxy inference. Requests go directly from your
# machine to your provider. `rovanta config init` stores these in a 0600
# config file; environment variables override it, and --provider / --model /
# --base-url flags override both. The API key is never accepted as a flag.
#
# openai-compatible | anthropic | google
ROVANTA_PROVIDER=
# Model id as your provider names it.
ROVANTA_MODEL=
# Required for openai-compatible, e.g. a local server on http://localhost.
ROVANTA_BASE_URL=
ROVANTA_API_KEY=
# Fallbacks used when ROVANTA_API_KEY is not set, matched to the provider:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=        (or GOOGLE_API_KEY)

# --- Market data (CoinGecko) ------------------------------------------------
# Optional. Without a key, the public CoinGecko API is used with its own
# rate limits. Review the provider's terms of use before use.
COINGECKO_API_KEY=
# "demo" -> https://api.coingecko.com/api/v3
# "pro"  -> https://pro-api.coingecko.com/api/v3
COINGECKO_API_PLAN=demo

# --- Robinhood Chain (initial ecosystem support) ----------------------------
# No endpoints are bundled. Take these values from the official Robinhood
# Chain documentation. URLs must be https (http is accepted only for
# localhost). RPC URLs are never included in report sources.
ROBINHOOD_CHAIN_RPC_URL=
# Numeric chain id, e.g. as listed in the official documentation.
ROBINHOOD_CHAIN_ID=
# Block explorer base URL, used to build links in report sources.
ROBINHOOD_CHAIN_EXPLORER_URL=
# Blockscout-compatible explorer API base. Optional; enables address
# transaction history and token balance lists.
ROBINHOOD_CHAIN_EXPLORER_API_URL=
# Native gas token symbol.
ROBINHOOD_CHAIN_NATIVE_SYMBOL=ETH

# --- Ethereum (optional) ----------------------------------------------------
# An Ethereum mainnet RPC endpoint you are allowed to use.
ETHEREUM_RPC_URL=
# Block explorer base URL, used to build links in report sources.
ETHEREUM_EXPLORER_URL=
# Blockscout-compatible explorer API base. Optional.
ETHEREUM_EXPLORER_API_URL=

# --- Execution --------------------------------------------------------------
# Not read. Execution is not implemented in this build and is hard-coded
# off regardless of any environment variable.
